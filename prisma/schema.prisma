generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id        Int      @id @default(autoincrement())
  userName      String
  email     String   @unique
  role      UserRole     @default(user)

  // password  String
  // createdAt DateTime @default(now())

  profile Profile?  // one-to-one relationship with Profile
  posts   Post[] // one-to-many relationship with Post
  @@map("users") 
}





model Profile {
  id     Int    @id @default(autoincrement())
  bio    String?
  userId Int    @unique

  user User @relation(fields: [userId], references: [id])
  @@map("profiles")
}

 





model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id]) 
  upadatedAt  DateTime @updatedAt
  postCategories PostCategory[] // many-to-many relationship with Category through PostCategory
@@map("posts")
 
}







model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique

  posts PostCategory[] // many-to-many relationship with Post through PostCategory
  @@map("categories")
}




//##############

enum UserRole {
  user
  admin
}


model PostCategory {
  postId     Int
  categoryId Int

  post     Post     @relation(fields: [postId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([postId, categoryId])
  @@map("post_categories")
}
